{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/data/:path*", "destination": "https://me.selenium79.workers.dev/adama/data/:path*" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }]
    }
  ]
}
