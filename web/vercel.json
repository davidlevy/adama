{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/place/data/:path*",
      "destination": "https://me.selenium79.workers.dev/adama/data/:path*"
    },
    {
      "source": "/place/:slug([A-Za-z0-9-]+)/@:loc",
      "destination": "/"
    },
    {
      "source": "/place/:slug([A-Za-z0-9-]+)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/place/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
