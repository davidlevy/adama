{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/place/:slug([A-Za-z0-9-]+)/:rest*",
      "destination": "/"
    },
    {
      "source": "/place/:slug([A-Za-z0-9-]+)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
